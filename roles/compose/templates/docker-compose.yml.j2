services:
  {{ mariadb_container }}:
    container_name: {{ mariadb_container }}
    build: {{ target_mariadb_path }}
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", root, "-p{{ vault_mysql_root_password }}"]
      timeout: 5s
      retries: 5
      interval: 10s
    volumes:
      - {{ mariadb_volume }}:/var/lib/mysql
    restart: always
    environment:
        MYSQL_ROOT_PASSWORD: {{ vault_mysql_root_password }}
        WORDPRESS_DB_NAME: {{ vault_wp_db_name }}
        WORDPRESS_DB_USER: {{ vault_wp_db_name }}
        WORDPRESS_DB_PASSWORD: {{ vault_wp_db_pass }}
    networks:
       - {{ network_name }}

  {{ phpmyadmin_container }}:
    container_name: {{ phpmyadmin_container }}
    build: {{ build_dir }}/{{ phpmyadmin_container }}
    restart: always
    healthcheck:
      test: [ "CMD-SHELL", "curl -f http://localhost || exit 1 " ]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    depends_on:
      {{ mariadb_container }}:
        condition: service_healthy
    environment:
      PMA_HOST: {{ mariadb_container }}
      BLOWFISH_SECRET: {{ vault_blowfish_secret }}
    networks:
      - {{ network_name }}

  {{ wordpress_container }}:
    container_name: {{ wordpress_container }}
    build: {{ build_dir }}/{{ wordpress_container }}
    restart: always
    depends_on:
      {{ mariadb_container }}:
          condition: service_healthy
    volumes:
      - {{ wordpress_volume }}:/var/www/html
    healthcheck:
      test: ["CMD", "nc", "-z", "127.0.0.1", "9000"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 15s
    environment:
      WORDPRESS_DB_NAME: {{ vault_wp_db_name }} 
      WORDPRESS_DB_USER: {{ vault_wp_db_name }}
      WORDPRESS_DB_PASSWORD: {{ vault_wp_db_pass }}
      WORDPRESS_DB_HOST: {{ mariadb_container }}
      WP_DB_PORT: {{ mariadb_container_port }}
      WP_SITE_URL: {{ domain_name }}
      WP_SITE_TITLE: {{ wp_site_title }}
      WP_ADMIN_USER: {{ vault_WP_ADMIN_USER }}
      WP_ADMIN_PASSWORD: {{ vault_WP_ADMIN_PASSWORD }}
      WP_ADMIN_EMAIL: {{  vault_WP_ADMIN_EMAIL  }}
    networks:
      - {{ network_name }}

  {{ nginx_container }}:
    container_name: {{ nginx_container }}
    build: {{ build_dir }}/{{ nginx_container }}
    depends_on:
      {{ wordpress_container }}:
        condition: service_healthy
      {{ phpmyadmin_container }}:
        condition: service_healthy
    volumes:
      - {{ wordpress_volume }}:/var/www/html
      - /etc/letsencrypt:/etc/letsencrypt:ro
      - /var/lib/letsencrypt:/var/lib/letsencrypt
    restart: always
    ports:
      - "443:443"
      - "80:80"
    environment:
      DOMAIN_NAME: {{ domain_name }}
    networks:
      - {{ network_name }}
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost/healthz || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s


volumes:
  {{ mariadb_volume }}:
  {{ wordpress_volume }}:

networks:
  {{ network_name }}:
